From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mili CI <xucy@Mili.com>
Date: Mon, 10 Aug 2026 23:57:43 +0800
Subject: [PATCH] Add EntityLungeEvent for kinetic weapon lunge


diff --git a/src/main/java/io/papermc/paper/event/entity/EntityLungeEvent.java b/src/main/java/io/papermc/paper/event/entity/EntityLungeEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..02c7b52384c43c4d9f0d6101f699e68c58bbc928
--- /dev/null
+++ b/src/main/java/io/papermc/paper/event/entity/EntityLungeEvent.java
@@ -0,0 +1,66 @@
+package io.papermc.paper.event.entity;
+
+import org.bukkit.entity.LivingEntity;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.entity.EntityEvent;
+import org.jetbrains.annotations.ApiStatus;
+import org.jspecify.annotations.NullMarked;
+
+/**
+ * Called when an entity performs a lunge attack (e.g. with a kinetic weapon).
+ * <p>
+ * The lunge power determines the strength of the lunge effect applied to the entity.
+ * This event can be cancelled to prevent the lunge from being applied.
+ */
+@NullMarked
+public class EntityLungeEvent extends EntityEvent {
+
+    private static final HandlerList HANDLER_LIST = new HandlerList();
+
+    private int lungePower;
+
+    @ApiStatus.Internal
+    public EntityLungeEvent(final LivingEntity entity, final int lungePower) {
+        super(entity);
+        this.lungePower = lungePower;
+    }
+
+    /**
+     * Gets the entity that is performing the lunge.
+     *
+     * @return the lungeing entity
+     */
+    @Override
+    public LivingEntity getEntity() {
+        return (LivingEntity) super.getEntity();
+    }
+
+    /**
+     * Gets the lunge power.
+     * <p>
+     * The lunge power determines the strength of the lunge effect.
+     *
+     * @return the lunge power
+     */
+    public int getLungePower() {
+        return lungePower;
+    }
+
+    /**
+     * Sets the lunge power.
+     *
+     * @param lungePower the new lunge power
+     */
+    public void setLungePower(final int lungePower) {
+        this.lungePower = lungePower;
+    }
+
+    @Override
+    public HandlerList getHandlers() {
+        return HANDLER_LIST;
+    }
+
+    public static HandlerList getHandlerList() {
+        return HANDLER_LIST;
+    }
+}
