# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build
/run
**/bin/
# Cargo 的 bin target 源码目录 src/bin/ 是源码而非构建输出，需从上面的 **/bin/ 规则中排除
!mili-rust/src/rust/src/bin/
!mili-rust/src/rust/src/bin/**/*
*.class
/lophine-server/build.gradle.kts
/lophine-api/build.gradle.kts
/lophine-server/src/minecraft
/mili-server/src/minecraft
/paper-server
/paper-api
/paper-api-generator
/lophine-src

.idea/
.vscode/
libs/
mili-rust/src/rust/target

# Paperweight auto-clones Minecraft resources/data into these dirs during build
# They contain their own .git repos which get mistaken for submodules
mili-server/src/minecraft/resources

# Agent working state (task list, local notes). Useful locally, not project source.
.workbuddy/
scripts/check_java_basics.py
