From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mili <mili@mili.fun>
Date: Mon, 21 Jul 2025 00:00:00 +0800
Subject: [PATCH] Fix config save truncation using atomic temp file write

---
 .../luminol/config/ConfigsInstance.java       | 25 ++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/src/main/java/me/earthme/luminol/config/ConfigsInstance.java b/src/main/java/me/earthme/luminol/config/ConfigsInstance.java
index 6c96114aca59260f03873e82a338c639afc92653..43aea0d16ee4c4a1a5646a6deb8e55d866e50ed8 100644
--- a/src/main/java/me/earthme/luminol/config/ConfigsInstance.java
+++ b/src/main/java/me/earthme/luminol/config/ConfigsInstance.java
@@ -723,7 +723,30 @@ public class ConfigsInstance {
      * Save configuration to file
      */
     public void saveConfigs() {
-        configFileInstance.save();
+        File tempFile = new File(baseConfigFile.getParent(), baseConfigFile.getName() + ".tmp");
+        try {
+            CommentedFileConfig tempConfig = CommentedFileConfig.builder(tempFile.toPath(),
+                    new com.electronwill.nightconfig.toml.TomlFormat()).build();
+            tempConfig.clear();
+            for (String key : defaultvalueMap.keySet()) {
+                Object value = configFileInstance.get(key);
+                if (value != null) {
+                    tempConfig.set(key, value);
+                }
+                String comment = configFileInstance.getComment(key);
+                if (comment != null && !comment.isEmpty()) {
+                    tempConfig.setComment(key, comment);
+                }
+            }
+            tempConfig.save();
+            tempConfig.close();
+            java.nio.file.Files.move(tempFile.toPath(), baseConfigFile.toPath(),
+                    java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        } catch (Exception e) {
+            logger.error("Failed to save config via temp file, falling back to direct save", e);
+            try { tempFile.delete(); } catch (Exception ignored) {}
+            configFileInstance.save();
+        }
     }
 
     /**
