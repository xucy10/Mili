From: Mili <mili@mili.fun>
Date: Mon, 21 Jul 2025 00:00:00 +0800
Subject: [PATCH] Fix ClassLoadUtil: add ClassGraph fallback for Paperclip

diff --git a/src/main/java/me/earthme/luminol/utils/ClassLoadUtil.java b/src/main/java/me/earthme/luminol/utils/ClassLoadUtil.java
index 23f498a2dc1be0345b3f2a6fb722ef1925baab0..2ad120b000000000000000000000000000000001 100644
--- a/src/main/java/me/earthme/luminol/utils/ClassLoadUtil.java
+++ b/src/main/java/me/earthme/luminol/utils/ClassLoadUtil.java
@@ -1,7 +1,11 @@
 package me.earthme.luminol.utils;
 
+import io.github.classgraph.ClassGraph;
+import io.github.classgraph.ScanResult;
 import net.minecraft.server.MinecraftServer;
 import org.jetbrains.annotations.NotNull;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
 
 import java.io.File;
 import java.io.IOException;
@@ -16,13 +20,14 @@ import java.util.jar.JarEntry;
 import java.util.jar.JarFile;
 
 public class ClassLoadUtil {
+    private static final Logger LOGGER = LoggerFactory.getLogger(ClassLoadUtil.class);
+
     public static @NotNull Set<Class<?>> getClasses(String pack) {
         Set<Class<?>> classes = new LinkedHashSet<>();
-        String packageDirName = pack.replace('.', '/');
-        Enumeration<URL> dirs;
 
         try {
-            dirs = MinecraftServer.class.getClassLoader().getResources(packageDirName);
+            String packageDirName = pack.replace('.', '/');
+            Enumeration<URL> dirs = MinecraftServer.class.getClassLoader().getResources(packageDirName);
             while (dirs.hasMoreElements()) {
                 URL url = dirs.nextElement();
                 String protocol = url.getProtocol();
@@ -41,7 +46,22 @@ public class ClassLoadUtil {
                 }
             }
         } catch (IOException e) {
-            throw new RuntimeException(e);
+            LOGGER.warn("Standard classloader scan failed for package {}, trying ClassGraph fallback", pack, e);
+        }
+
+        if (classes.isEmpty()) {
+            LOGGER.info("No classes found via standard classloader for package {}, using ClassGraph", pack);
+            try (ScanResult scanResult = new ClassGraph()
+                    .acceptPackages(pack)
+                    .overrideClassLoaders(MinecraftServer.class.getClassLoader())
+                    .scan()) {
+                for (Class<?> clazz : scanResult.getAllClasses().loadClasses()) {
+                    classes.add(clazz);
+                }
+                LOGGER.info("ClassGraph found {} classes in package {}", classes.size(), pack);
+            } catch (Exception e) {
+                LOGGER.error("ClassGraph scan also failed for package {}", pack, e);
+            }
         }
 
         return classes;
