From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xucy10 <xucy10@example.com>
Date: Thu, 10 Jul 2026 00:00:00 +0800
Subject: [PATCH] Add SSL certificate error handling for version fetcher


diff --git a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
index 28371ecf31d5fc280aaa03ed9a86f5b565cf32f6..abcdef1234567890abcdef1234567890abcdef12 100644
--- a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
+++ b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
@@ -120,7 +120,9 @@ public class PaperVersionFetcher implements VersionFetcher {
             }
         } catch (final NumberFormatException e) {
             COMPONENT_LOGGER.warn("Error while parsing version", e);
+        } catch (final javax.net.ssl.SSLException e) { // Mili - handle SSL certificate errors gracefully
+            COMPONENT_LOGGER.warn("SSL error while fetching version from GitHub (this is normal if your Java runtime lacks proper CA certificates)", e);
         } catch (final Exception e) {
             COMPONENT_LOGGER.error("Error while parsing version", e);
         }