@@ -286,14 +286,36 @@ public class RedStoneWireBlock extends Block {
     }
     // Folia end - region threading
 
+    // Mili start - redstone refactoring: extract repeated implementation checks
+    /**
+     * Determines if the Alternate Current redstone implementation should be used.
+     * Consolidates the fastRedstoneDust (Carpet) and ALTERNATE_CURRENT (Paper) checks
+     * that were previously inlined across onPlace, onRemove, affectNeighborsAfterRemoval,
+     * and neighborChanged.
+     */
+    private static boolean shouldUseAlternateCurrent(Level level) {
+        return fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
+            || level.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT;
+    }
+
+    /**
+     * Determines if the Eigencraft (Paper optimized) redstone implementation should be used.
+     * Eigencraft is selected when fastRedstoneDust is disabled and the world config
+     * is set to EIGENCRAFT. Otherwise, vanilla updatePowerStrength is used.
+     */
+    private static boolean shouldUseEigencraft(Level level) {
+        return !fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
+            && level.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.EIGENCRAFT;
+    }
+    // Mili end - redstone refactoring
+
     /*
      * Modified version of pre-existing updateSurroundingRedstone, which is called from
      * this.neighborChanged and a few other methods in this class.
      * Note: Added 'source' argument so as to help determine direction of information flow
      */
     private void updateSurroundingRedstone(Level worldIn, BlockPos pos, BlockState state, @Nullable Orientation orientation, boolean blockAdded) {
-        if (!fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
-            && worldIn.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.EIGENCRAFT) {
+        if (shouldUseEigencraft(worldIn)) {
             // since 24w33a the source pos is no longer given, but instead an Orientation parameter
             // when this is not null, it can be used to find the source pos, which the turbo uses
             // to find the direction of information flow
@@ -368,8 +390,8 @@ public class RedStoneWireBlock extends Block {
     protected void onPlace(final BlockState state, final Level level, final BlockPos pos, final BlockState oldState, final boolean movedByPiston) {
         if (!oldState.is(state.getBlock()) && !level.isClientSide()) {
             // Paper start - optimize redstone - replace call to updatePowerStrength
-            if (fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
-                || level.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT) {
+            // Mili - redstone refactoring: use extracted helper
+            if (shouldUseAlternateCurrent(level)) {
                 level.getWireHandler().onWireAdded(pos, state); // Alternate Current
             } else {
                 this.updateSurroundingRedstone(level, pos, state, null, true); // Vanilla/Eigencraft
@@ -394,8 +416,8 @@ public class RedStoneWireBlock extends Block {
             }
 
             // Paper start - optimize redstone - replace call to updatePowerStrength
