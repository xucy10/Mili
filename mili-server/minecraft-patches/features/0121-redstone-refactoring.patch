                 level.getWireHandler().onWireRemoved(pos, state); // Alternate Current
             } else {
                 this.updateSurroundingRedstone(level, pos, state, null, false); // Vanilla/Eigencraft
@@ -415,8 +437,8 @@ public class RedStoneWireBlock extends Block {
