     static boolean isLevelAtLeast(ValueInput input, int level) {
@@ -6563,5 +6563,41 @@ public abstract class Entity
     }
     // Paper end
 
+    // Mili start - entity culling
+    private boolean mili_cullTimeout = false;
+    private boolean mili_forcedVisible = false;
+    private boolean mili_culled = false;
+    private boolean mili_outOfCamera = false;
+
+    @Override
+    public void setTimeout() {
+        this.mili_cullTimeout = true;
+    }
+
+    @Override
+    public boolean isForcedVisible() {
+        return this.mili_forcedVisible;
+    }
+
+    @Override
+    public void setCulled(boolean value) {
+        this.mili_culled = value;
+    }
+
+    @Override
+    public boolean isCulled() {
+        return this.mili_culled;
+    }
+
+    @Override
+    public void setOutOfCamera(boolean value) {
+        this.mili_outOfCamera = value;
+    }
+
+    @Override
+    public boolean isOutOfCamera() {
+        return this.mili_outOfCamera;
+    }
+    // Mili end - entity culling
     public boolean shouldTickHot() { return this.tickCount > 20 * 10 && this.isAlive(); } // KioCG
 }
