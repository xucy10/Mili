+                this.mili$cullEntities(viewerList);
+            }
+            // Mili end - Rust batch entity culling
+
             if (lastChunkUpdate != currChunkUpdate || lastTrackedChunk != chunk) {
                 // need to purge any players possible not in the chunk list
                 for (final ServerPlayerConnection conn : new java.util.ArrayList<>(this.seenBy)) {
@@ -1427,5 +1437,53 @@
                 this.updatePlayer(serverPlayer);
             }
         }
+
+        // Mili start - Rust batch entity culling integration
+        public void mili$cullEntities(java.util.List<ServerPlayer> viewers) {
+            if (viewers.isEmpty() || !fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.enabled) {
+                return;
+            }
+            if (!(this.entity instanceof dev.tr7zw.entityculling.versionless.access.Cullable cullable)) {
+                return;
+            }
+            if (cullable.isForcedVisible() || this.entity.isCurrentlyGlowing()) {
+                cullable.setCulled(false);
+                return;
+            }
+            if (this.entity.getType().skipRaytracningCheck) {
+                cullable.setCulled(false);
+                return;
+            }
+            // Use Rust native bulk culling if available
+            if (fun.bm.mili.rust.EntityCullHelper.isNativeAvailable()) {
+                java.util.List<Entity> entityList = java.util.Collections.singletonList(this.entity);
+                for (ServerPlayer viewer : viewers) {
+                    byte[] results = fun.bm.mili.rust.EntityCullHelper.cullEntitiesNative(
+                        viewer, entityList,
+                        fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.tracingDistance,
+                        fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.hitboxLimit
+                    );
+                    if (results != null && results.length > 0) {
+                        boolean culled = results[0] == 1 || results[0] == 4;
+                        cullable.setCulled(culled);
+                    }
+                }
+            } else {
+                // Java fallback: simple distance-based culling
+                boolean anyVisible = false;
+                for (ServerPlayer viewer : viewers) {
+                    double dx = this.entity.getX() - viewer.getX();
+                    double dz = this.entity.getZ() - viewer.getZ();
+                    double distSq = dx * dx + dz * dz;
+                    double reach = fun.bm.mili.config.modules.experiment.RayTrackingEntityTrackerConfig.tracingDistance;
+                    if (distSq <= reach * reach) {
+                        anyVisible = true;
+                        break;
+                    }
+                }
+                cullable.setCulled(!anyVisible);
+            }
+        }
+        // Mili end - Rust batch entity culling integration
     }
 }
