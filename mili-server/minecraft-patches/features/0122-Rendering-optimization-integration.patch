         }
         //KioCG end
         this.tickChildren(haveTime, region); // Folia - region threading
+        // Mili start - dynamic view distance manager tick
+        if (region != null && io.papermc.paper.threadedregions.RegionizedServer.getCurrentTick() % 20 == 0) {
