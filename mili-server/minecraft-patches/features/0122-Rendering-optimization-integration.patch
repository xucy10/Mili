@@ -97,6 +97,12 @@ public class ServerEntity {
     // Paper end - fix desync when a player is added to the tracker
 
     public void sendChanges() {
+        // Mili start - skip entity update packets if culled
+        if (this.entity instanceof dev.tr7zw.entityculling.versionless.access.Cullable cullable && cullable.isCulled()) {
+            this.tickCount++;
+            return;
+        }
+        // Mili end - skip entity update packets if culled
         // Paper start - optimise collisions
         if (((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)this.entity).moonrise$isHardColliding()) {
             this.teleportDelay = 9999;
