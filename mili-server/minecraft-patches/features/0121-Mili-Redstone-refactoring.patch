+    // Mili start - redstone refactoring: extract repeated implementation checks
+    /**
+     * Determines if the Alternate Current redstone implementation should be used.
+     * Consolidates the fastRedstoneDust (Carpet) and ALTERNATE_CURRENT (Paper) checks
+     * that were previously inlined across onPlace, onRemove, affectNeighborsAfterRemoval,
+     * and neighborChanged.
+     */
+    private static boolean shouldUseAlternateCurrent(Level level) {
+        return fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
+            || level.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.ALTERNATE_CURRENT;
+    }
+
+    /**
+     * Determines if the Eigencraft (Paper optimized) redstone implementation should be used.
+     * Eigencraft is selected when fastRedstoneDust is disabled and the world config
+     * is set to EIGENCRAFT. Otherwise, vanilla updatePowerStrength is used.
+     */
+    private static boolean shouldUseEigencraft(Level level) {
+        return !fun.bm.mili.carpet.config.modules.GeneralCompatConfig.fastRedstoneDust
+            && level.paperConfig().misc.redstoneImplementation == io.papermc.paper.configuration.WorldConfiguration.Misc.RedstoneImplementation.EIGENCRAFT;
+    }
+    // Mili end - redstone refactoring
+
     /*
      * Modified version of pre-existing updateSurroundingRedstone, which is called from
      * this.neighborChanged and a few other methods in this class.
      * Note: Added 'source' argument so as to help determine direction of information flow
      */
